<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3. -->
    <style name="Theme.SnowLiveWallpaper" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/snow_blue</item>
        <item name="colorOnPrimary">@color/snow_white</item>
        <item name="colorPrimaryContainer">@color/snow_blue_light</item>
        <item name="colorOnPrimaryContainer">@color/snow_text_dark</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/snow_accent</item>
        <item name="colorOnSecondary">@color/snow_white</item>
        <item name="colorSecondaryContainer">@color/snow_accent</item>
        <item name="colorOnSecondaryContainer">@color/snow_white</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/snow_surface</item>
        <item name="colorSurface">@color/snow_surface</item>
        <item name="colorOnSurface">@color/snow_text_dark</item>
        <item name="colorSurfaceVariant">@color/snow_blue_light</item>
        <item name="colorOnSurfaceVariant">@color/snow_text_dark</item>

        <!-- Outlines / dividers (Material 3 defaults are purple-tinted). -->
        <item name="colorOutline">@color/snow_blue</item>
        <item name="colorOutlineVariant">@color/snow_blue_light</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/snow_surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Fix for Tonal Buttons on some devices -->
        <item name="colorTertiary">@color/snow_blue_light</item>
        <item name="colorOnTertiary">@color/snow_text_dark</item>
        <item name="colorTertiaryContainer">@color/snow_surface</item>
        <item name="colorOnTertiaryContainer">@color/snow_text_dark</item>
    </style>
</resources>