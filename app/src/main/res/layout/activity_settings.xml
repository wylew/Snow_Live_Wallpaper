<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/snow_surface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/snow_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleCentered="true"
            app:titleTextColor="@color/snow_text_dark">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:src="@drawable/snowflake"
                android:contentDescription="Snowflake icon" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipChildren="false">

            <!-- Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.wylew.snowlivewallpaper.WallpaperPreviewView
                        android:id="@+id/wallpaper_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#222" />

                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/btn_select_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_margin="16dp"
                        android:text="Select Image"
                        android:textColor="@color/snow_text_dark"
                        app:backgroundTint="@color/snow_blue_light"
                        app:icon="@android:drawable/ic_menu_gallery"
                        app:iconTint="@color/snow_text_dark"
                        app:elevation="4dp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Two Column Settings Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="8dp"
                android:clipChildren="false">

                <!-- Column 1 (Left) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp"
                    android:clipChildren="false">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_flake_count"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_flake_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_flake_size"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_flake_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_flake_color"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_flake_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Swirl Speed"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_turbulence_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_transparency"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_transparency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />
                </LinearLayout>

                <!-- Column 2 (Right) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:clipChildren="false">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_wind_strength"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_wind_strength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:stepSize="0.05"
                        app:tickVisible="true"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_fall_speed"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_fall_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_rotation_speed"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_rotation_speed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Swirl Radius"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_turbulence_radius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />

                    <!-- Reset Defaults Button in Right Column -->
                    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                        android:id="@+id/btn_reset_defaults"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="Defaults"
                        android:textColor="@color/snow_text_dark"
                        app:backgroundTint="@color/snow_blue_light"
                        app:icon="@android:drawable/ic_menu_preferences"
                        app:iconTint="@color/snow_text_dark"
                        app:elevation="4dp" />
                </LinearLayout>
            </GridLayout>

            <!-- Snowflake Styles (chips are added in SettingsActivity.setupDesignChips) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_flake_designs"
                android:textSize="16sp"
                android:textColor="@color/snow_text_dark" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pref_flake_designs_hint"
                android:textSize="13sp"
                android:textColor="@color/snow_text_dark"
                android:alpha="0.7" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_designs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="false" />

            <!-- Collection Settings Section -->
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_collect_at_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_collect_at_bottom"
                android:textSize="16sp"
                android:textColor="@color/snow_text_dark"
                app:buttonTint="@color/snow_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:text="Settle Probability defines the likelihood a snowflake will stick to the screen. Settle Area Height controls the percent of the screen flakes can settle on, starting from the bottom. Can impact performance."
                android:textSize="12sp"
                android:textColor="@color/snow_text_dark"
                android:alpha="0.7" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginTop="8dp">

                <!-- Left: Settle Probability -->
                <LinearLayout
                    android:id="@+id/layout_settle_prob"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">
                    <TextView
                        android:id="@+id/label_settle_prob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Settle Probability"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_settle_probability"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />
                </LinearLayout>

                <!-- Right: Settle Area Height -->
                <LinearLayout
                    android:id="@+id/layout_settle_height"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">
                    <TextView
                        android:id="@+id/label_settle_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Settle Area Height"
                        android:textSize="16sp"
                        android:textColor="@color/snow_text_dark" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_settle_height"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:thumbColor="@color/snow_blue"
                        app:trackColorActive="@color/snow_blue" />
                </LinearLayout>
            </GridLayout>

            <!-- Empty space to allow scrolling above FAB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_set_wallpaper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:text="Set Wallpaper"
        android:textColor="@color/snow_white"
        app:backgroundTint="@color/snow_accent"
        app:icon="@android:drawable/ic_menu_set_as"
        app:iconTint="@color/snow_white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
